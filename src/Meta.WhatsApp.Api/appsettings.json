{
  "ConnectionStrings": {
    "WhatsApp": "Server=(localdb)\\mssqllocaldb;Database=WhatsAppMessaging;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Meta": {
    "GraphApiBaseUrl": "https://graph.facebook.com/",
    "ApiVersion": "v23.0"
  },
  "KeyVault": {
    "VaultUri": null,
    "SecretCacheMinutes": 5
  },
